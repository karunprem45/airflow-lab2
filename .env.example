# Copy to .env (setup.sh does this for you) and adjust.
# Your host user id, so files Airflow writes are owned by you. setup.sh fills this in.
AIRFLOW_UID=50000

# ---- Optional: e-mail alerts --------------------------------------------
# Leave LAB2_ALERT_EMAIL empty to only log alerts in the task logs.
# For Gmail, create an app password: https://support.google.com/accounts/answer/185833
# then URL-encode it inside the connection string below (@ -> %40).
LAB2_ALERT_EMAIL=
# AIRFLOW_CONN_SMTP_DEFAULT=smtp://YOUREMAIL%40gmail.com:APP_PASSWORD@smtp.gmail.com:587?from_email=YOUREMAIL%40gmail.com&disable_ssl=true
